# LLM Provider Configuration
LLM_PROVIDER=ollama
FALLBACK_PROVIDER=
LLM_TIMEOUT_S=180
LLM_TEMPERATURE=0.3

# Ollama (Local)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=4096

# Anthropic (Cloud - Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Groq (Cloud - Optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Knowledge Base & Retrieval
AUTO_INGEST=true
KB_PATH=/app/data/lennys-podcast-transcripts/episodes
KB_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts
RETRIEVAL_TOP_K=6
MIN_QUERY_COVERAGE=0.5

# Database & System
POSTGRES_PASSWORD=lenny
ADMIN_TOKEN=
LOG_LEVEL=INFO
